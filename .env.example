PORT=5000

# PostgreSQL: componentes separados. src/db/database-url.ts compone la URL.
# No agregues DATABASE_URL ni subas tu contraseña real.
PGHOST=localhost
PGPORT=5432
PGDATABASE=controllabs
PGUSER=postgres
PGPASSWORD=REEMPLAZAR_POR_TU_PASSWORD
PGSCHEMA=public

# JWT: genera un secreto aleatorio de al menos 32 bytes. No lo subas a Git.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
